diff --git a/libcody/buffer.cc b/libcody/buffer.cc
index 85c066fef..8c582cfcf 100644
--- a/libcody/buffer.cc
+++ b/libcody/buffer.cc
@@ -150,7 +150,11 @@ void MessageBuffer::AppendInteger (unsigned u)
   // gcc 4.8, which is a C++11 compiler lacking std::to_string.  so
   // have something horrible.
   std::string v (20, 0);
+#ifdef sgi
+  size_t len = sprintf (const_cast<char *> (v.data ()), "%u", u);
+#else
   size_t len = snprintf (const_cast<char *> (v.data ()), v.size (), "%u", u);
+#endif
   v.erase (len);
 
   AppendWord (v);
