@@ -838,9 +838,9 @@ __gthread_recursive_mutex_init_function (__gthread_recursive_mutex_t *__mutex)
       int __r;
 
       __r = __gthrw_(pthread_mutexattr_init) (&__attr);
-      if (!__r)
-	__r = __gthrw_(pthread_mutexattr_settype) (&__attr,
-						   PTHREAD_MUTEX_RECURSIVE);
+//      if (!__r)
