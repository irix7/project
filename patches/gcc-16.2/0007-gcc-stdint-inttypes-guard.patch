Guard GCC's stdint types against IRIX <inttypes.h>

IRIX 6.5's <inttypes.h> defines int8_t..uint64_t, intmax_t/uintmax_t and
intptr_t/uintptr_t in its own typedef block. __inttypes_INCLUDED is that
header's own guard macro, defined at the top of that block; gating
stdint-gcc.h's duplicate exact-width and greatest-width typedefs on it, and
setting it afterwards, lets either inclusion order compile. The limits and
constant macros stay outside the guard: the capture's inttypes.h defines
its limit macros only when its _SGIAPI predicate holds, which it does not
by default, so inttypes-first still needs INT32_MAX and friends from
stdint-gcc.h.

Re-checked against the 6.5.7m capture for issue #30, where use_gcc_stdint
is provide and stdint-gcc.h is installed directly (0001): both orders
compile for o32 and n32, and the intptr_t/uintptr_t typedefs left outside
the guard resolve to the same long/unsigned long types the capture's
inttypes.h uses. No hunk change was needed from the pdaxrom original.

Provenance: pdaxrom/irix-gcc tag 1.2 (2aa3421b),
gcc-15.2.0-irix65-abi64.diff.

diff --git a/gcc/ginclude/stdint-gcc.h b/gcc/ginclude/stdint-gcc.h
index 1f9b8c845..f4444bd37 100644
--- a/gcc/ginclude/stdint-gcc.h
+++ b/gcc/ginclude/stdint-gcc.h
@@ -30,6 +30,7 @@ see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
 
 /* 7.8.1.1 Exact-width integer types */
 
+#ifndef __inttypes_INCLUDED
 #ifdef __INT8_TYPE__
 typedef __INT8_TYPE__ int8_t;
 #endif
@@ -54,6 +55,7 @@ typedef __UINT32_TYPE__ uint32_t;
 #ifdef __UINT64_TYPE__
 typedef __UINT64_TYPE__ uint64_t;
 #endif
+#endif
 
 /* 7.8.1.2 Minimum-width integer types */
 
@@ -88,8 +90,12 @@ typedef __UINTPTR_TYPE__ uintptr_t;
 
 /* 7.8.1.5 Greatest-width integer types */
 
+#ifndef __inttypes_INCLUDED
 typedef __INTMAX_TYPE__ intmax_t;
 typedef __UINTMAX_TYPE__ uintmax_t;
+#endif
+
+#define __inttypes_INCLUDED
 
 #if (!defined __cplusplus || __cplusplus >= 201103L \
      || defined __STDC_LIMIT_MACROS)
