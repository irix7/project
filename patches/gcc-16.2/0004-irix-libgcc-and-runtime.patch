+/*__gthrw(pthread_rwlock_rdlock)*/
+/*__gthrw(pthread_rwlock_tryrdlock)*/
+/*__gthrw(pthread_rwlock_wrlock)*/
+/*__gthrw(pthread_rwlock_trywrlock)*/
